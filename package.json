{
  "name": "@netlogix/stencil-hydrate-server",
  "version": "1.5.0",
  "license": "MIT",
  "description": "output target for stencil to generate server for hydrating components",
  "main": "dist/output-target.js",
  "scripts": {
    "build": "concurrently \"npm:build:output-target\" \"npm:build:server\" \"npm:build:types\"",
    "build:output-target": "rollup --config rollup.config.output-target.mjs",
    "build:server": "rollup --config rollup.config.server.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "build:dev": "concurrently \"npm:build:dev:output-target\" \"npm:build:dev:server\" \"npm:build:dev:types\"",
    "build:dev:output-target": "rollup --config rollup.config.output-target.mjs -w",
    "build:dev:server": "rollup --config rollup.config.server.mjs -w",
    "build:dev:types": "tsc --emitDeclarationOnly --watch",
    "format": "prettier --write '**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/netlogix/stencil-hydrate-server.git"
  },
  "dependencies": {
    "rollup": "^4.52.5"
  },
  "peerDependencies": {
    "@stencil/core": "^4.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@stencil/core": "^4.38",
    "@types/node": "^26.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
